; M2 VGA RGB222 scanout: unchanged timing and command format,
; but five six-bit pixels consume 30 of each 32-bit data word.
.program qvga222
.side_set 2
.define NOSYNC 0
.define HSYNC 1
.define VSYNC 2
.define VHSYNC 3
.define BPP 6

public hsync:
    jmp x--,hsync side HSYNC
public entry:
    out x,27 side HSYNC
    out pc,5 side HSYNC

public vsync:
    jmp x--,vsync side VSYNC
    out x,27 side VSYNC
    out pc,5 side VSYNC

public vhsync:
    jmp x--,vhsync side VHSYNC
    out x,27 side VHSYNC
    out pc,5 side VHSYNC

public dark:
    mov pins,null side NOSYNC
dark_loop:
    jmp x--,dark_loop side NOSYNC
.wrap_target
    out x,27 side NOSYNC
    out pc,5 side NOSYNC

public output:
    out pins,BPP side NOSYNC [2]
    jmp x--,output side NOSYNC [1]
    out pins,BPP side NOSYNC [2]
.wrap
