Sub Rep lbl$, secs
  Local us
  us = (secs * 1000 - base_us) / N%
  Print "BENCH "; lbl$; " "; Str$(us, 0, 3); " "; Str$(us * mhz, 0, 0)
End Sub

Sub Rep10 lbl$, secs
  Local us
  us = (secs * 1000 - base_us / 10) / (N% \ 10)
  Print "BENCH "; lbl$; " "; Str$(us, 0, 3); " "; Str$(us * mhz, 0, 0)
End Sub

Sub RepS lbl$, secs, bb
  Local us
  us = (secs * 1000 - bb) / N%
  Print "BENCH "; lbl$; " "; Str$(us, 0, 3); " "; Str$(us * mhz, 0, 0)
End Sub
