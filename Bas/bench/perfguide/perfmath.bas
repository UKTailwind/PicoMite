' M8a: rotate 1000 points in a loop
best = 1E9
For rep = 1 To 3
  t0 = Timer
  For k = 1 To 5
    ca = Cos(0.3) : sa = Sin(0.3)
    For j = 0 To 999
      xo(j) = 160 + (xi(j) - 160) * ca - (yi(j) - 120) * sa
      yo(j) = 120 + (xi(j) - 160) * sa + (yi(j) - 120) * ca
    Next
  Next
  dt = Timer - t0
  If dt < best Then best = dt
Next rep
Report "M8a", best, 5000

