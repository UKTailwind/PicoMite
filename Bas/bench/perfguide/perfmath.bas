' M11a: Shell sort of 1000 numbers in BASIC
best = 1E9
For rep = 1 To 3
  t0 = Timer
  c() = a()
  gp% = 500
  Do While gp% > 0
    For j = gp% To 999
      tmp = c(j) : k = j
      Do While k >= gp%
        If c(k - gp%) <= tmp Then Exit Do
        c(k) = c(k - gp%) : k = k - gp%
      Loop
      c(k) = tmp
    Next
    gp% = gp% \ 2
  Loop
  dt = Timer - t0
  If dt < best Then best = dt
Next rep
Report "M11a", best, 1000

