+/* PicoMite: restore TinyUSB 0.20's RX-timeout tolerance for CONTROL
+ * transfers, bounded. 0.20 never failed a transfer on RX_TIMEOUT - it
+ * cleared the status bit and let the SIE keep retrying, so a device slow
+ * to answer after a port reset (flash sticks, devices behind a slow hub)
+ * simply answered late. 0.21 fails the transfer on the first timeout;
+ * usbh's retries land back-to-back inside the same mute window and
+ * enumeration then abandons the device permanently (0.21 has no
+ * re-enumeration). Grace applies to endpoint 0 only: NAKs - the normal
+ * slow-device flow control on bulk/interrupt - never raise RX_TIMEOUT,
+ * so a timeout there is a real error and keeps 0.21's fast-fail.
+ * The window is opened by the first timeout and closed ONLY by a
+ * control-pipe completion - closing it on any completion would let hub
+ * status/HID traffic re-arm it forever and wedge the pipe. */
+#define PC3_CTRL_RX_TIMEOUT_GRACE_US (1000u * 1000u)
+static bool     pc3_rx_timeout_timing = false;
+static uint32_t pc3_rx_timeout_start_us;
+
 static void __tusb_irq_path_func(xfer_complete_isr)(hw_endpoint_t *ep, xfer_result_t xfer_result, bool is_more) {
+  if (tu_edpt_number(ep->ep_addr) == 0)
+    pc3_rx_timeout_timing = false; // control-pipe completion ends the grace window
   // Mark transfer as done before we tell the tinyusb stack
   uint32_t xferred_len = ep->xferred_len;
+#ifdef PC3_USB_EVLOG
+  pc3_evlog_add('X', ep->ep_addr | ((uint32_t)ep->dev_addr << 8), xfer_result, xferred_len);
+#endif
   rp2usb_reset_transfer(ep);
   hcd_event_xfer_complete(ep->dev_addr, ep->ep_addr, xferred_len, xfer_result, true);
 
