+    /* PicoMite: within the grace window an endpoint-0 timeout is NOT a
+       failure - leave the transfer armed, the SIE retries on its own
+       (0.20 behaviour). No STOP_TRANS: that would cancel the retry. */
+    bool pc3_in_grace = false;
+    if (epx->state == EPSTATE_ACTIVE && tu_edpt_number(epx->ep_addr) == 0) {
+      const uint32_t now = time_us_32();
+      if (!pc3_rx_timeout_timing) {
+        pc3_rx_timeout_timing   = true;
+        pc3_rx_timeout_start_us = now;
+      }
+      pc3_in_grace = (uint32_t)(now - pc3_rx_timeout_start_us) < PC3_CTRL_RX_TIMEOUT_GRACE_US;
+    }
+
+    if (!pc3_in_grace) {
     const uint32_t sie_ctrl = (usb_hw->sie_ctrl & SIE_CTRL_BASE_MASK) | USB_SIE_CTRL_STOP_TRANS_BITS;
     usb_hw->sie_ctrl        = sie_ctrl;
