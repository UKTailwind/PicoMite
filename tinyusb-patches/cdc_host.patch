+/* PicoMite: receive only on request.  Stock cdc_host arms the bulk IN at mount and re-arms it for good, so an
+   adapter that nothing reads (a CH340 with a loopback) keeps an IN transfer pending for as long as it is plugged in.
+   On the RP2 host every bulk and control transfer shares EPX, and while another transfer is pending the controller
+   stops on each NAK and EPX is switched: that idle IN took a turn after every NAK of a flash drive's transfer or of
+   an enumeration.  The application turns receiving on while it has the port open (MMBasic: OPEN "COMn:" .. CLOSE);
+   off aborts the IN, which releases the endpoint and gives the data toggle back, and empties the receive FIFO. */
+bool tuh_cdc_rx_enable(uint8_t idx, bool enable) {
+  cdch_interface_t * p_cdc = get_itf(idx);
+  TU_VERIFY(p_cdc && p_cdc->daddr != 0);
+  if (enable == p_cdc->rx_on) {
+    return true;
+  }
+  p_cdc->rx_on = enable;
+  if (enable) {
+    tu_edpt_stream_clear(&p_cdc->stream.rx);
+    (void)tu_edpt_stream_read_xfer(&p_cdc->stream.rx);
+  } else {
+    (void)tuh_edpt_abort_xfer(p_cdc->daddr, p_cdc->stream.rx.ep_addr); // false when no IN was pending
+    tu_edpt_stream_clear(&p_cdc->stream.rx);
+  }
   return true;
 }
 
