 critical_section_t rp2usb_lock;
 
+/* PicoMite: USB host fault record.  The RP2 host driver answers three
+ * recoverable bus conditions with panic(), which on a PicoMite is both fatal
+ * and invisible: pico-stdio is not wired to the console, so panic()'s message
+ * is discarded and the breakpoint in _exit() surfaces only as MMBasic's own
+ * "*** FAULT PC=..." line (RP2040 has no CFSR/HFSR, so those print as zero and
+ * say nothing).  Record and recover instead; PicoMite reports the record from
+ * the main loop, off the interrupt (USB_fault_service, input/USBKeyboard.c).
+ *   1 = ERROR_DATA_SEQ, 2 = stale AVAIL in bufctrl_write32,
+ *   3 = stale AVAIL in bufctrl_write16. */
+#define PM_USB_FAULT_BUFCTRL32 2u
+#define PM_USB_FAULT_BUFCTRL16 3u
+volatile uint8_t  pm_usb_fault_code;
+volatile uint16_t pm_usb_fault_count;
+void __tusb_irq_path_func(pm_usb_fault_note)(uint8_t code) {
+  pm_usb_fault_code = code;
+  if (pm_usb_fault_count != 0xFFFFu) {
+    pm_usb_fault_count++;
+  }
+}
+
+#ifdef PC3_USB_EVLOG
+#include "hardware/timer.h"
+/* PC3: timing-neutral event ring for the USB host driver.  A UART print in
+ * the interrupt path made a multi-device enumeration succeed that fails
+ * without it (2026-09-01), so the instrument must not take time: four
+ * stores per event, read back over the REPL from Python (address from the
+ * ELF's pc3_evlog symbol).  Tags: 'S' transfer start (ep_addr|dev_addr<<8,
+ * total_len, 0), 'C' buffer completion (buf_id|is_double<<8|is_done<<16,
+ * bc32, xact|remaining<<16), 'I' hcd interrupt (ints, sie_status, 0),
+ * 'X' transfer complete to the stack (ep_addr|dev_addr<<8, result, len). */
+typedef struct { uint32_t t; uint32_t tag; uint32_t a; uint32_t b; uint32_t c; } pc3_ev_t;
+#ifndef PC3_EVLOG_N /* PicoMite: overridable - HDMIUSB has ~2.7 KB BSS headroom, 256*20B does not fit */
+#define PC3_EVLOG_N 256
+#endif
+volatile pc3_ev_t pc3_evlog[PC3_EVLOG_N];
+volatile uint32_t pc3_evlog_n;
+/* PicoMite: freeze the ring shortly after the FIRST failed transfer so the
+   lead-up and the failure survive instead of being overwritten by later
+   traffic (a whole failed multi-device enumeration is ~750 events; the ring
+   holds 112). -1 = armed, >0 = events still to record, 0 = frozen. PEEK
+   pc3_evlog_freeze to see whether a failure triggered. */
+volatile int32_t pc3_evlog_freeze = -1;
+void pc3_evlog_add(uint32_t tag, uint32_t a, uint32_t b, uint32_t c) {
+    if (pc3_evlog_freeze == 0) return;
+    if (pc3_evlog_freeze > 0) pc3_evlog_freeze--;
+    uint32_t i = pc3_evlog_n++;
+    volatile pc3_ev_t *e = &pc3_evlog[i % PC3_EVLOG_N];
+    e->t = time_us_32();
+    e->tag = tag; e->a = a; e->b = b; e->c = c;
+    if (tag == 'X' && b != 0 /* xfer_result != SUCCESS */ && pc3_evlog_freeze < 0)
+        pc3_evlog_freeze = 40;
+}
+#endif
+
