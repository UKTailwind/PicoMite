+
 static void enum_full_complete(bool success) {
   (void)success;
   TU_LOG_USBH("Enumeration complete: success = %u\r\n", success);
@@ -2238,6 +2288,15 @@
   #if CFG_TUH_HUB
   // Hub status is already requested in case of successful enumeration
   if (!success && _usbh_data.dev0_bus.hub_addr != 0) {
+    /* PicoMite: the abandoned device is left ENABLED on its port, parked
+       at USB address 0. If it answers later it talks over every subsequent
+       address-0 enumeration: garbled descriptors, SET_ADDRESS captured by
+       the wrong device, device-table entries whose identity/port no longer
+       match reality (observed: pulling a never-enumerated flash stick
+       unmounted the touch panel). Disable the port so a failed device
+       stays parked until replugged. */
+    hub_port_clear_feature(_usbh_data.dev0_bus.hub_addr, _usbh_data.dev0_bus.hub_port,
+                           HUB_FEATURE_PORT_ENABLE, pc3_port_disable_complete, 0);
     hub_edpt_status_xfer(_usbh_data.dev0_bus.hub_addr);
   }
   #endif
