# ---- Claude Code personal/local config (paths, command allowlist) ----
.claude/settings.local.json

# ---- Build trees (CMake out-of-source dirs reused across variants) ----
build*/
_tmp/
CMakeFiles/
CMakeCache.txt

# ---- Firmware build artifacts ----
*.uf2
*.zip
*.elf
*.bin
*.hex
*.map
# TILEMAP LOAD files under Bas/ are program data, not linker maps
!Bas/**/*.map
*.dis

# ---- Python ----
__pycache__/
*.pyc
.venv/
.venv-1/

# ---- Node (VS Code extension) ----
vscode-mmbasic/node_modules/

# ---- Generated docs / extracts ----
doxygen/html/
*.pdf
!PDF/*.pdf
_docx_extract/

# ---- Packaged VS Code extension builds ----
*.vsix

# ---- Video-converter sample/generated media (video/) keep .py/.bas/.md ----
video/*.mp4
video/*.332
video/*.r332
video/*.r332c
video/*.121
video/*.vid
video/*.aud
video/*.vc

# ---- find_static_globals.py / find_dead_globals.py accumulate caches ----
.static_scan.json
.dead_scan.json

# ---- Editor / OS / Office temp & manual backups ----
~$*
*.bak_*
*.pdf.bak*
*.tmp
dist/

# ---- Scratch output written to the repo root by image save/load tests ----
# Anchored to the root so test images kept elsewhere (Testfiles/, video/)
# are still tracked.
/test.bmp
/test.png
Bas/elite_tools/cache/

# the mmb2csub distribution unpacked in the tree for use - a working copy,
# like the uf2s, not something the repo carries
/mmb2csub/

# ---- Picanoid working files, deliberately not carried ----
# The design study and the pre-release snapshots of the game still hold the
# material the shipped game was rewritten to do without: decoded sprite
# bitmaps, the round layouts as JSON, and the disassembly's own names all
# through the comments.  Only the finished game, its build tools and the
# player's guide are tracked.
/docs/Arkanoid_Port_Plan.html
/Bas/arkanoid.bas
/Bas/arkanoid_field.bas

# ---- Asset-converter inputs and outputs, never carried ----
# The engine in Bas/sandglass ships with no game data in it: the player points
# the converter at their own copy of the published source release and it writes
# the data files onto their machine.  Nothing that conversion touches belongs in
# this repository, so a stray clone or a test run cannot be committed by
# accident.
/Bas/sandglass_tools/out/
/Bas/sandglass_tools/*.bmp
/Bas/sandglass_tools/*.idx
/Bas/sandglass_tools/*.dat
/Bas/sandglass_tools/convert.log
/Bas/sandglass/*.bmp
/Bas/sandglass/*.idx
/Bas/sandglass/*.dat
Prince-of-Persia-Apple-II/
Bas/sandglass_tools/music/
Bas/sandglass_tools/*.min.bas
Bas/sandglass_tools/*.map

# Prince of Pico: what setup.py leaves behind.  release/ is the published
# source release and board/ is the data converted from it - neither is ours to
# commit, any more than to redistribute.
Bas/sandglass_tools/release/
Bas/sandglass_tools/board/
Bas/sandglass_tools/art.idx
Bas/sandglass_tools/convert.log
