# Embed TinyCC's system headers (core/tcc/include/*.h) in the firmware.
#
#   cmake -DSRC_DIR=<dir with the .h files> -DOUT=<generated .c> -DHDR=<tcc_picomite.h>
#         [-DEXTRA=<file>[|<file>...]] -P tcc_rom_headers.cmake
#
# Subdirectories of SRC_DIR keep their path ("picomite/system.h").  EXTRA
# files (separated by '|') are added under their own name, at the top.
# The generated file defines tcc_pm_rom_files[] / tcc_pm_rom_count, which the
# adapter (core/tcc/tcc_picomite.c) serves as "rom:/include/<name>".  It is
# rewritten only when its content changes, so a rebuild does not recompile it.

if(NOT SRC_DIR OR NOT OUT OR NOT HDR)
    message(FATAL_ERROR "tcc_rom_headers: SRC_DIR, OUT and HDR are required")
endif()

file(GLOB_RECURSE _headers RELATIVE "${SRC_DIR}" "${SRC_DIR}/*.h")
list(SORT _headers)
set(_paths "")
foreach(_h IN LISTS _headers)
    list(APPEND _paths "${SRC_DIR}/${_h}")
endforeach()
if(EXTRA)
    string(REPLACE "|" ";" _extra "${EXTRA}")
    foreach(_e IN LISTS _extra)
        get_filename_component(_n "${_e}" NAME)
        list(APPEND _headers "${_n}")
        list(APPEND _paths "${_e}")
    endforeach()
endif()

# Headers are shipped verbatim as FLASH byte arrays. Strip comments from the
# embedded copies only; external users keep the documented source headers.
if(NOT PYTHON)
    find_program(PYTHON NAMES python3 python)
endif()
if(NOT PYTHON)
    message(FATAL_ERROR "tcc_rom_headers: Python interpreter not found")
endif()
set(_commentless_dir "${OUT}.headers")
execute_process(
    COMMAND "${PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/tcc_strip_header_comments.py"
            "${_commentless_dir}" ${_paths}
    RESULT_VARIABLE _strip_status ERROR_VARIABLE _strip_error)
if(NOT _strip_status STREQUAL "0")
    message(FATAL_ERROR "tcc_rom_headers: comment stripping failed: ${_strip_error}")
endif()

set(_c "/* Generated by cmake/tcc_rom_headers.cmake from core/tcc/include - do not edit */\n")
string(APPEND _c "#include \"${HDR}\"\n\n")
set(_table "")
set(_count 0)
list(LENGTH _headers _n)
math(EXPR _last "${_n} - 1")
foreach(_i RANGE ${_last})
    list(GET _headers ${_i} _h)
    list(GET _paths ${_i} _p)
    file(READ "${_commentless_dir}/${_i}.h" _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _size "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    # 16 bytes a line
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " _bytes "${_bytes}")
    string(MAKE_C_IDENTIFIER "${_h}" _id)
    string(APPEND _c "static const unsigned char rom_${_id}[${_size}] = {\n    ${_bytes}\n};\n")
    string(APPEND _table "    {\"${_h}\", rom_${_id}, ${_size}},\n")
    math(EXPR _count "${_count} + 1")
endforeach()

file(REMOVE_RECURSE "${_commentless_dir}")

string(APPEND _c "\nconst tcc_pm_rom_file tcc_pm_rom_files[] = {\n${_table}};\n")
string(APPEND _c "const unsigned int tcc_pm_rom_count = ${_count};\n")

file(WRITE "${OUT}.tmp" "${_c}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
